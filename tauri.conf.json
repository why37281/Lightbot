{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightBot",
  "version": "0.1.0",
  "identifier": "com.lightbot.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LightBot - 轻量 QQ AI 机器人",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
